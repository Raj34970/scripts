{{- range .Values.subdomains }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ .serviceName }}
  namespace: {{ $.Values.namespace | default "web" }}
spec:
  ports:
  - port: {{ .servicePortExternal | default 80 }}
    targetPort: {{ .servicePort }}
    protocol: TCP
  selector:
    # This assumes your apps are labeled with their names
    app: {{ .name }} 
{{- end }}