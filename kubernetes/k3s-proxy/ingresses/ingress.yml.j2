{{- range .Values.subdomains }}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ .name }}-ingress
  annotations:
    cert-manager.io/cluster-issuer: {{ $.Values.clusterIssuer }}
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
spec:
  ingressClassName: nginx
  tls:
  - hosts:
    - {{ .name }}.{{ $.Values.globalDomain }}
    secretName: {{ .name }}-tls
  rules:
  - host: {{ .name }}.{{ $.Values.globalDomain }}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: {{ .serviceName }}
            port:
              number: {{ .servicePort }}
{{- end }}